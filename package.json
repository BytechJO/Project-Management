{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma dev --name bytech-pm --detach && tsx scripts/wait-for-database.ts",
    "dev": "next dev",
    "build": "next build",
    "netlify:build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx scripts/run-security-tests.ts",
    "test:security:unit": "tsx --test tests/security/policies.test.ts",
    "test:security:http": "tsx --test tests/security/http.test.ts",
    "test:exports": "node --conditions=react-server --import tsx scripts/verify-profitability-exports.ts",
    "test:hours-exports": "node --conditions=react-server --import tsx scripts/verify-hours-report-exports.ts",
    "test:hours-calculation": "node --conditions=react-server --import tsx scripts/verify-hours-report-calculation.ts",
    "db:start": "prisma dev --name bytech-pm --detach",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:prepare-clean-deployment": "tsx scripts/prepare-clean-deployment.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.15.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12 <25"
  }
}
