# Add these values in Netlify Project configuration > Environment variables.
# Never upload this template after replacing its placeholders with real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED-HOST/DATABASE?sslmode=require"
DATABASE_POOL_SIZE="1"
BETTER_AUTH_SECRET="generate-a-unique-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="https://YOUR-SITE.netlify.app"

# Used only when running `pnpm prisma db seed` in a protected administration environment.
BOOTSTRAP_ADMIN_EMAIL="admin@bytechjo.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-strong-production-password"
BOOTSTRAP_ADMIN_NAME="Bytech Admin"

# Optional OneDrive integration.
MICROSOFT_TENANT_ID="your-microsoft-entra-tenant-id"
MICROSOFT_CLIENT_ID="your-microsoft-entra-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-entra-client-secret"
MICROSOFT_REDIRECT_URI="https://YOUR-SITE.netlify.app/api/integrations/onedrive/callback"
ONEDRIVE_TOKEN_ENCRYPTION_KEY="generate-a-separate-random-secret-of-at-least-32-characters"

# Recommended for Next.js deploy consistency on Netlify.
NETLIFY_NEXT_SKEW_PROTECTION="true"
